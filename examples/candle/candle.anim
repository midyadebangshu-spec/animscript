shape cflame_out = curve(x: "873.0 + select(u < 1, 1, -1) * 27 * pow(sin(pi * pow(select(u < 1, u, 2 - u), 0.72)), 1.15) * (1 - 0.3 * select(u < 1, u, 2 - u))", y: "497.0 - 100 * select(u < 1, u, 2 - u)", from: 0, to: 2, n: 64, closed: true)
