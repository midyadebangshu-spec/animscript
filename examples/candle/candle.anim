cflame_core.stroke_width = 0
cflame_core.opacity = 0
cflame_core.z = 68
shape cflame_base = curve(x: "873.0 + 6 * cos(u)", y: "497.0 + 3 + 8 * sin(u)", from: 0, to: 6.283185307179586, n: 16, closed: true)
