let pencil = brush("pencil", radius: 2, color: #333333)
let ink    = brush("ink", radius: 3.2, color: #1c3d6b)
let chalk  = brush("charcoal", radius: 4, color: #5a3d2b)

# `freehand` fits cubic Bezier curves through the points (tolerance in pixels): a vector shape, filled like any other
shape heart = freehand(rough_c, tolerance: 7, closed: true)
heart.fill = #ff8fab
heart.stroke = #b23a5b
heart.stroke_width = 3
heart.opacity = 0

shape art = paint_layer(z: 5)

scene "Freehand" for 12.seconds:
    main:
        # 1. the raw points, painted with a pencil: every wobble is there
        art.stroke(pencil, rough_a) over 2.5.seconds
        # 2. `smooth` fits a curve and samples it: the same points, drawn as a clean line
        art.stroke(ink, smooth(rough_b, tolerance: 7, closed: true, spacing: 3)) over 2.5.seconds
        # 3. the fitted shape fades in, then a chalk line is drawn along its outline with `outline`
        heart.fade_in(over: 1.second)
        art.stroke(chalk, outline(heart, spacing: 3)) over 2.5.seconds
        # a rectangle drawn "by hand": resample the corners, jitter them, paint
        art.stroke(pencil, jitter(resample([(90, 440), (710, 440), (710, 560), (90, 560), (90, 440)], 4), amount: 3, scale: 25, seed: "box")) over 2.seconds
        wait 1.second
