project "Brush strokes":
    anim_version: "0.1"
    canvas: 800x600
    fps: 24
    background: #f6f1e4

import "std/2d"

# brushes: libmypaint, driven by the same settings as in MyPaint (name a bundled brush or a .myb file)
let pencil = brush("pencil", radius: 2.2, color: #3a3a3a)
let marker = brush("marker", radius: 9, color: #d6336c, opacity: 0.55)
let leafy  = brush("ink", radius: 3.5, color: #2f7d32)
let coal   = brush("charcoal", radius: 7, color: #444444)
let pen    = brush("calligraphy", radius: 5, color: #1c3d6b)

# a sun in plain vector art, under the painting
shape sun = circle(32, radius: 46, at: (130, 110))
sun.fill = #ffe066
sun.stroke = none

# the painting is a layer of its own: it can be moved, faded and zoomed like any shape
shape art = paint_layer(z: 5, resolution: 2)

scene "Sketch" for 16.seconds:
