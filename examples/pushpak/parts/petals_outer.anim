## Pushpak Viman: the outermost layer of petals, `petals_outer`. It is the second layer unrolled: the same long petals
## but lying flat along the base, not curled up, as long as the second layer's whole curve. Translucent like the dome
## (opacity 0.9, some light through), a dark gold leaf with glowing gold edges and veins.
import "petal_lib"

param axis_x = 640
param base_y = 514
param r_base = 100
param length = 307
param half_w = 44
param count = 11

shape petals_outer = petal_flat_ring(axis_x, base_y, r_base, length, half_w, -0.08, count, 0.turns)
petals_outer.fill = #b8862e
petals_outer.opacity = 0.9
petals_outer.surface(roughness: 0.12, metallic: 1, emissive: 0.45, transmission: 1.2)
# gold glowing edges and a pale vein; fine veins sweep out from the centre
# a polished-metal sheen: a bright band across each blade about 40% of the way out, strongest down its middle
petals_outer.pattern(mask: "max((abs(u - 0.5) * 2 > 0.9) || (abs(u - 0.5) * 2 < 0.03) || (abs(fract(v * 16 + abs(u - 0.5) * 3) - 0.5) > 0.47 && abs(u - 0.5) * 2 < 0.9), 0.8 * exp(-(((v - 0.4) / 0.2) ^ 2)) * (1 - abs(u - 0.5) * 1.1))", color: #ffe9a0, glow: 2.2, alpha: 1)
petals_outer.stroke_width = 0.35

project "Pushpak outer petals":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #f0b070

preview:
    stage3(fov: 40, exposure: 1.1, bloom: 0.2, quality: "medium", smooth: 55.deg, crease: 38.deg)
    shape sun = sun_light(dir: (-0.5, 0.5, 0.8), color: #ffd9a0, intensity: 2.2, size: 3)
    shape sky = ambient_light(color: #ffb27a, ground: #5a3a2a, intensity: 0.5)

scene "preview" for 3.seconds:
    main:
        camera3.orbit(turns: 0.1, over: 3.seconds)
