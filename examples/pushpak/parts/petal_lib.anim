## Pushpak Viman: shared petal-making functions (plain AnimScript). A petal is a ribbon (`sheet`) along a curved spine,
## repeated around the vertical axis; the three petal layers differ only in the numbers they pass.
import "std/3d"

# the spine of one petal in the plane z = 0 to the right of the axis, starting at radius r0: `lean` is how far the tip
# ends up outside the base, and `s` makes the petal S-shaped (it leans out steeply at the base, straightens in the middle
# and flicks out again at the tip); s = 0 gives a plain slant. `bulge` pushes the lower part of the petal outwards (most
# about 40% of the way up, nothing at the base or the tip), which makes the petals belly out like a lotus. `flare` bends the last 40% outwards, so the tip points outward. `sway` is the same S sideways (along the ring), which
# is what shows as an S when you look at the face of a petal.
fn petal_spine(x: Number, base_y: Number, height: Number, r0: Number, lean: Number, bulge: Number, flare: Number, s: Number, sway: Number, n: Int) -> List:
    return (0..n).map(i -> (x + r0 + lean * i / n + bulge * sin(0.5.turns * sqrt(i / n) * sqrt(sqrt(i / n))) + flare * max(0, i / n - 0.6) * max(0, i / n - 0.6) / 0.16 + s * sin(i / n * 1.turns), base_y - height * i / n, sway * sin(i / n * 1.turns)))

# half the width of the petal at t (0 at the base, 1 at the tip): broad low down, pointed at the tip
fn petal_width(half_w: Number, t: Number) -> Number:
    let sn = sin(0.5.turns * sqrt(t) * sqrt(sqrt(t)))
    return half_w * (0.3 * (1 - t) * (1 - t) + sqrt(sn) * sqrt(sqrt(sn)))

# a petal's surface can also wave: `wave` is the amplitude (px, out of the face) and `waves` the cycles from base to tip
# one ring of `count` petals about the vertical line through x; `spin` turns every petal about its own vertical axis
# (through its base), so the ring becomes a pinwheel
fn petal_ring(x: Number, base_y: Number, height: Number, r0: Number, lean: Number, bulge: Number, flare: Number, spin: Angle, s: Number, sway: Number, wave: Number, waves: Number, half_w: Number, cup: Number, count: Int, phase: Angle) -> Shape:
    return sheet(spine: petal_spine(x, base_y, height, r0, lean, bulge, flare, s, sway, 14), width: (0..14).map(i -> petal_width(half_w, i / 14)), cup: cup, across: 8, facing: (1, 0, 0), around: count, about: (x, 0), phase: phase, spin: spin, wave: wave, waves: waves)

# a ring of `count` petals that come out of the base flat and curl up in one curve: each starts at radius r0 heading
# outwards and its tip points straight up. `length` is the petal's length along its curve (the tip ends about 0.64 of
# it out and up); the width runs across z the whole way.
fn petal_arc_ring(x: Number, base_y: Number, r0: Number, length: Number, half_w: Number, cup: Number, count: Int, phase: Angle) -> Shape:
    return sheet(spine: (0..14).map(i -> (x + r0 + length * i / 14, base_y, 0)), width: (0..14).map(i -> petal_width(half_w, i / 14)), cup: cup, across: 8, side: (0, 0, 1), curl: 0.25.turns, toward: (0, -1, 0), around: count, about: (x, 0), phase: phase)
