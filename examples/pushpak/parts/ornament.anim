## Pushpak Viman: henna-style (mehndi) border designs, written as equations. Each design is a band: a repeat of one
## motif around the band (`n` cells), drawn in ink. A design is a string that is 1 where there is ink and 0 elsewhere,
## in the cell coordinates
##     X   across one cell, from -0.5 to 0.5 (the motif's centre is X = 0)
##     Y   up the band measured in cell widths, from 0 at the bottom (`a` cell widths tall in all)
## and uses the named numbers `n` (cells around) and `a` (band height over cell width). On the dome a band's holes are
## everything that is not ink (`hole: "1 - (" + design + ")"`), so the gold body shows through the lace.
##   lace_edge   a scalloped lace edge with pointed tips      fans     big half-circle fans with a dotted ring
##   shells      shells standing on a row of arches            tulips   a row of small solid trefoils
##   rainbow     rows of nested arches                         stripes  fine parallel lines over a scalloped row
let X = "(fract(u * n) - 0.5)"
let Y = "(v * a)"

# ---- building blocks: all take their numbers as text, so they can be written into the equation ---------------------
fn dist(cx: String, cy: String) -> String:
    return "sqrt((" + X + " - (" + cx + ")) ^ 2 + (" + Y + " - (" + cy + ")) ^ 2)"

fn ang(cx: String, cy: String) -> String:
    return "atan2(" + Y + " - (" + cy + "), " + X + " - (" + cx + "))"

# an arc of radius r about (cx, cy), upper half only, w thick
fn arc(cx: String, cy: String, r: String, w: String) -> String:
    return "(abs(" + dist(cx, cy) + " - " + r + ") < " + w + " && " + Y + " > " + cy + ")"

# a filled disc
fn disc(cx: String, cy: String, r: String) -> String:
    return "(" + dist(cx, cy) + " < " + r + ")"

# k dots of radius rad on the arc of radius r (upper half only)
fn ring_dots(cx: String, cy: String, r: String, k: String, rad: String) -> String:
    return "(((((fract(" + ang(cx, cy) + " * " + k + " / 6.2832) - 0.5) * 6.2832 * " + r + " / " + k + ") ^ 2 + (" + dist(cx, cy) + " - " + r + ") ^ 2) < (" + rad + ") ^ 2) && " + Y + " > " + cy + ")"

# k thin spokes between radii r0 and r1 (upper half only)
fn spokes(cx: String, cy: String, k: String, r0: String, r1: String, w: String) -> String:
    return "(" + dist(cx, cy) + " > " + r0 + " && " + dist(cx, cy) + " < " + r1 + " && " + Y + " > " + cy + " && abs((fract(" + ang(cx, cy) + " * " + k + " / 6.2832 + 0.5) - 0.5) * 6.2832 * " + dist(cx, cy) + " / " + k + ") < " + w + ")"

# a ring of k rounded petals between radii r0 and r1: their scalloped outline (upper half only)
fn petals(cx: String, cy: String, k: String, r0: String, r1: String, w: String) -> String:
    return "(abs(" + dist(cx, cy) + " - (" + r0 + " + (" + r1 + " - " + r0 + ") * abs(sin(" + ang(cx, cy) + " * " + k + " / 2)))) < " + w + " && " + Y + " > " + cy + ")"

fn hline(y: String, w: String) -> String:
    return "(abs(" + Y + " - (" + y + ")) < " + w + ")"

fn any3(a: String, b: String, c: String) -> String:
    return "(" + a + " || " + b + " || " + c + ")"

# a fan: a half-circle with an outer double arc, a dotted ring, a scalloped petal ring, spokes and a centre
fn fan(cx: String, cy: String, r: String, k: String) -> String:
    return "(" + arc(cx, cy, r, "0.02") + " || " + arc(cx, cy, r + " - 0.065", "0.014") + " || " + ring_dots(cx, cy, r + " - 0.13", "22", "0.022") + " || " + petals(cx, cy, k, r + " * 0.3", r + " * 0.7", "0.018") + " || " + spokes(cx, cy, k, "0.03", r + " * 0.3", "0.011") + " || " + disc(cx, cy, r + " * 0.07") + ")"

# ---- the designs ---------------------------------------------------------------------------------------------------
fn or2(a: String, b: String) -> String:
    return "(" + a + " || " + b + ")"

fn or3(a: String, b: String, c: String) -> String:
    return "(" + a + " || " + b + " || " + c + ")"

fn or4(a: String, b: String, c: String, d: String) -> String:
    return "(" + a + " || " + b + " || " + c + " || " + d + ")"

# a spike rising towards the cell edge on both sides (so two cells make a pointed tip), `h` high at the edge
fn spike(y0: String, rise: String, w: String) -> String:
    return "(abs(" + X + ") > 0.22 && abs(" + Y + " - (" + y0 + " + " + rise + " * (abs(" + X + ") - 0.22))) < " + w + ")"

# a solid ellipse centred (cx, cy) with half-sizes (rx, ry)
fn blob(cx: String, cy: String, rx: String, ry: String) -> String:
    return "(((" + X + " - (" + cx + ")) / " + rx + ") ^ 2 + ((" + Y + " - (" + cy + ")) / " + ry + ") ^ 2 < 1)"

# lace_edge: scalloped lace, a = 1.0
let lace_edge = or4(fan("0", "0.05", "0.46", "12"), arc("0", "0.05", "0.5", "0.022"), or2(spike("0.47", "1.5", "0.02"), spike("0.40", "1.5", "0.02")), or3(hline("0.014", "0.018"), hline("0.07", "0.016"), ring_dots("0", "0.05", "0.55", "28", "0.02")))

# fans: big half-circle fans with small shells at the cusps and dots round the top, a = 0.85
let fans = or4(fan("0", "0.08", "0.48", "18"), or2(fan("0.5", "0.5", "0.27", "9"), fan("-0.5", "0.5", "0.27", "9")), or2(ring_dots("0", "0.08", "0.535", "46", "0.012"), arc("0.5", "0.5", "0.3", "0.016")), or3(hline("0.015", "0.014"), hline("0.06", "0.006"), arc("-0.5", "0.5", "0.3", "0.016")))

# shells: arches (three lines each) with shells standing on the cusps, a = 1.05
let shells = or4(arc("0", "0.02", "0.49", "0.012"), or2(arc("0", "0.02", "0.41", "0.015"), arc("0", "0.02", "0.33", "0.015")), or2(fan("0.5", "0.5", "0.3", "11"), fan("-0.5", "0.5", "0.3", "11")), or2(hline("0.012", "0.012"), hline("0.05", "0.006")))

# tulips: a row of small solid trefoils on a stem, a = 0.6
let tulips = or4(blob("0", "0.33", "0.07", "0.17"), or2(blob("-0.12", "0.27", "0.06", "0.1"), blob("0.12", "0.27", "0.06", "0.1")), "(abs(" + X + ") < 0.022 && " + Y + " > 0.04 && " + Y + " < 0.2)", or2(hline("0.03", "0.02"), "(" + Y + " > 0.55 && " + Y + " < 0.56)"))

# rainbow: nested arches, a = 0.6
let rainbow = or4(arc("0", "0.03", "0.47", "0.02"), arc("0", "0.03", "0.38", "0.02"), or2(arc("0", "0.03", "0.29", "0.02"), arc("0", "0.03", "0.20", "0.02")), or3(arc("0", "0.03", "0.11", "0.02"), hline("0.012", "0.012"), hline("0.57", "0.016")))

# stripes: fine parallel lines over a row of double scallops, a = 0.55
let stripes = or4(hline("0.03", "0.011"), hline("0.09", "0.006"), or2(arc("0", "0.16", "0.47", "0.011"), arc("0", "0.16", "0.38", "0.015")), or2(hline("0.5", "0.012"), hline("0.45", "0.006")))
