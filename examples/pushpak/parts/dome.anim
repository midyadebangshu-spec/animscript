## Pushpak Viman: the dome (the balloon). An egg-shaped body, bands of ornament, a heavy waist band and a crown.
## Opened on its own it previews itself; imported, the project and scene below are ignored.
##   shapes: body, band_a .. band_e, waist, belt, crown_a, crown_b, crown_c, tip
## `dome_x` and `dome_top` place it (the top of the body, in px) so the main file can move the whole dome.
import "std/3d"

param dome_x = 640
param dome_top = 200
param dome_h = 380
param dome_r = 175

# the outline: t = 0 at the top of the body, 1 at the bottom. Fullest about a third of the way down, narrowing to the neck.
# (A lathe profile is (radius, height) with height going UP, so the screen y is negated in `strip`.)
fn egg(t: Number) -> Number:
    let u = 1.35 * t - 0.35 * t * t
    return dome_r * sqrt(sin(u * 0.5.turns)) * (1.12 - 0.28 * t)

fn egg_y(t: Number) -> Number:
    return dome_top + dome_h * t

# a strip of the outline between t0 and t1, `gain` times the body's radius (so a band sits just outside it)
fn strip(t0: Number, t1: Number, n: Int, gain: Number) -> List:
    return (0..n).map(i -> (egg(t0 + (t1 - t0) * i / n) * gain, -egg_y(t0 + (t1 - t0) * i / n)))

shape body = lathe(profile: strip(0.02, 0.98, 32, 1), segments: 64, at: (dome_x, egg_y(0.5), 0))
body.fill = #e8a24a
body.fill = #f0a53c
body.surface(roughness: 0.6, emissive: 1.2)

# ---- ornament: dark lace over the glowing body ------------------------------------------------------------
# A band is a lathe strip drawn in ink; `hole` cuts everything that is not ink, so the glowing body shows through.
# A cell of the repeat is (x, y) in -0.5..0.5: `n` cells go round the band and `a` is the cell's height over its width.
let cell = "sqrt((fract(u * n) - 0.5) * (fract(u * n) - 0.5) + (v - 0.5) * a * (v - 0.5) * a)"
let corner = "abs(abs(fract(u * n) - 0.5) + abs((v - 0.5) * a) - 0.78) < 0.03"
let frame = "v < 0.035 || v > 0.965"
# a medallion: two rings, spokes, a centre dot, a diamond about the cell corners and a frame at the band's edges
let medallion = "1 - ((abs(" + cell + " - 0.4) < 0.03) || (abs(" + cell + " - 0.27) < 0.022) || (" + cell + " < 0.075) || (" + cell + " < 0.25 && " + cell + " > 0.1 && abs(sin(atan2((v - 0.5) * a, fract(u * n) - 0.5) * 6)) > 0.82) || (" + corner + ") || " + frame + ")"
# a lattice: crossing diagonals with a dot in each diamond
let lattice = "1 - ((abs(abs(fract(u * n) - 0.5) + abs((v - 0.5) * a) - 0.35) < 0.05) || (" + cell + " < 0.12) || " + frame + ")"
# scallops: a row of arches with a small dot under each
let scallop = "1 - ((abs(sqrt((fract(u * n) - 0.5) * (fract(u * n) - 0.5) + (v - 0.2) * a * (v - 0.2) * a) - 0.46) < 0.05 && v < 0.62) || (sqrt((fract(u * n) - 0.5) * (fract(u * n) - 0.5) + (v - 0.72) * a * (v - 0.72) * a) < 0.1) || " + frame + ")"

# the height of a strip over the width of one of its n cells, so the cells come out square
fn aspect(t0: Number, t1: Number, n: Int) -> Number:
    return (t1 - t0) * dome_h * n / (6.283 * egg((t0 + t1) / 2))

shape band_a = lathe(profile: strip(0.08, 0.33, 12, 1.012), segments: 96, at: (dome_x, egg_y(0.2), 0), double_sided: true)
band_a.fill = #2c1608
band_a.pattern(hole: medallion, n: 9, a: aspect(0.08, 0.33, 9))
band_a.surface(roughness: 0.6, emissive: 0.05)
shape band_b = lathe(profile: strip(0.34, 0.365, 3, 1.016), segments: 64, at: (dome_x, egg_y(0.35), 0), double_sided: true)
band_b.fill = #f2c56b
band_b.surface(roughness: 0.35, metallic: 0.6, emissive: 0.5)
shape band_c = lathe(profile: strip(0.375, 0.5, 8, 1.012), segments: 96, at: (dome_x, egg_y(0.44), 0), double_sided: true)
band_c.fill = #2c1608
band_c.pattern(hole: lattice, n: 20, a: aspect(0.375, 0.5, 20))
band_c.surface(roughness: 0.6, emissive: 0.05)
shape band_d = lathe(profile: strip(0.51, 0.535, 3, 1.016), segments: 64, at: (dome_x, egg_y(0.52), 0), double_sided: true)
band_d.fill = #f2c56b
band_d.surface(roughness: 0.35, metallic: 0.6, emissive: 0.5)
shape band_e = lathe(profile: strip(0.545, 0.72, 10, 1.012), segments: 96, at: (dome_x, egg_y(0.63), 0), double_sided: true)
band_e.fill = #3a1a08
band_e.pattern(hole: scallop, n: 26, a: aspect(0.545, 0.72, 26))
band_e.surface(roughness: 0.6, emissive: 0.05)

# the waist: a gold band where the ropes hang, and the darker belt below it
shape waist = lathe(profile: strip(0.755, 0.785, 3, 1.03), segments: 64, at: (dome_x, egg_y(0.77), 0), double_sided: true)
waist.fill = #e9c25a
waist.surface(roughness: 0.3, metallic: 0.7, emissive: 0.5)
shape belt = lathe(profile: strip(0.80, 0.97, 8, 1.01), segments: 64, at: (dome_x, egg_y(0.885), 0), double_sided: true)
belt.fill = #4a200c
belt.pattern(hole: lattice, n: 30, a: aspect(0.80, 0.97, 30))
belt.surface(roughness: 0.6, emissive: 0.05)

# the crown: three stacked tiers and a spike
shape crown_a = lathe(profile: [(0, 0), (50, 0), (34, 14), (46, 22), (30, 40), (0, 44)], segments: 24, at: (dome_x, dome_top - 22, 0))
shape crown_b = lathe(profile: [(0, 0), (34, 0), (22, 14), (30, 20), (16, 38), (0, 46)], segments: 24, at: (dome_x, dome_top - 66, 0))
shape crown_c = lathe(profile: [(0, 0), (16, 0), (8, 14), (14, 24), (8, 42), (0, 52)], segments: 24, at: (dome_x, dome_top - 112, 0))
shape tip = lathe(profile: [(0, 0), (6, 0), (3, 24), (0, 36)], segments: 12, at: (dome_x, dome_top - 150, 0))
crown_a.fill = #d8a63e
crown_b.fill = #e9c25a
crown_c.fill = #d8a63e
tip.fill = #f2d27a
crown_a.surface(roughness: 0.3, metallic: 0.7, emissive: 0.4)
crown_b.surface(roughness: 0.3, metallic: 0.7, emissive: 0.4)
crown_c.surface(roughness: 0.3, metallic: 0.7, emissive: 0.4)
tip.surface(roughness: 0.2, metallic: 0.7, emissive: 0.4)

project "Pushpak dome":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #f0b070

preview:
    stage3(fov: 40, exposure: 1.1, bloom: 0.25, quality: "medium", smooth: 55.deg, crease: 38.deg)
    shape sun = sun_light(dir: (-0.5, 0.5, 0.8), color: #ffd9a0, intensity: 2.2, size: 3)
    shape sky = ambient_light(color: #ffb27a, ground: #5a3a2a, intensity: 0.5)

scene "preview" for 3.seconds:
    main:
        camera3.orbit(turns: 0.1, over: 3.seconds)
