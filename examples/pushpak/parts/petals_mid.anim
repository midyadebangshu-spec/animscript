## Pushpak Viman: the middle petals. Twelve broad petals that lean outward from the hub with their tips curled
## back, a translucent membrane with a dark lace frame and ribs.  Shape: `petals_mid`.
import "petal_lib"

param axis_x = 640
param base_y = 506
param height = 205
param r_base = 92
param lean = 170
param bulge = 50
param flare = 0
param spin = 0.09.turns
param s_bend = 0
param sway = 0
param wave = 12
param waves = 1.5
param count = 14
param half_w = 52

shape petals_mid = petal_ring(axis_x, base_y, height, r_base, lean, bulge, flare, spin, s_bend, sway, wave, waves, half_w, -0.3, count, 0.036.turns)
petals_mid.fill = #c9b0a4
petals_mid.opacity = 0.4
petals_mid.surface(roughness: 0.55, emissive: 0.45)
petals_mid.pattern(mask: "(abs(u - 0.5) * 2 > 0.84) || (abs(u - 0.5) * 2 < 0.03) || (abs(fract(v * 11 + abs(u - 0.5) * 3) - 0.5) > 0.46 && abs(u - 0.5) * 2 < 0.84)", color: #34200f, alpha: 0.95)

project "Pushpak middle petals":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #f0b070

preview:
    stage3(fov: 40, exposure: 1.1, bloom: 0.2, quality: "medium", smooth: 55.deg, crease: 38.deg)
    shape sun = sun_light(dir: (-0.5, 0.5, 0.8), color: #ffd9a0, intensity: 2.2, size: 3)
    shape sky = ambient_light(color: #ffb27a, ground: #5a3a2a, intensity: 0.5)

scene "preview" for 3.seconds:
    main:
        camera3.orbit(turns: 0.1, over: 3.seconds)
