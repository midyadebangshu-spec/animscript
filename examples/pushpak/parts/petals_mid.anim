## Pushpak Viman: the second layer of petals, `petals_mid`. Each comes out of the base flat, heading outwards, and
## curls up in ONE curve until its tip points straight up. They stand between the inner petals (the ring is turned half a
## step), a translucent lavender membrane with a dark lace frame, a vein and ribs.
import "petal_lib"

param axis_x = 640
param base_y = 506
param r_base = 100
param length = 300
param half_w = 50
param count = 11

shape petals_mid = petal_arc_ring(axis_x, base_y, r_base, length, half_w, -0.2, count, 0.04545.turns)
petals_mid.fill = #c9a7d8
petals_mid.opacity = 0.62
petals_mid.surface(roughness: 0.4, metallic: 0.3, emissive: 0.1, transmission: 2.2)
petals_mid.pattern(mask: "(abs(u - 0.5) * 2 > 0.86) || (abs(u - 0.5) * 2 < 0.035) || (abs(fract(v * 11 + abs(u - 0.5) * 2 + abs(u - 0.5) * abs(u - 0.5) * 2.4) - 0.5) > 0.455 && abs(u - 0.5) * 2 < 0.86)", color: #3a2414, alpha: 0.95)
petals_mid.stroke_width = 0.35

project "Pushpak middle petals":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #f0b070

preview:
    stage3(fov: 40, exposure: 1.1, bloom: 0.2, quality: "medium", smooth: 55.deg, crease: 38.deg)
    shape sun = sun_light(dir: (-0.5, 0.5, 0.8), color: #ffd9a0, intensity: 2.2, size: 3)
    shape sky = ambient_light(color: #ffb27a, ground: #5a3a2a, intensity: 0.5)

scene "preview" for 3.seconds:
    main:
        camera3.orbit(turns: 0.1, over: 3.seconds)
