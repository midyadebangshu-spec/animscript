## Pushpak Viman: the inner petals. Tall, cupped petals that rise from the hub and hug the dome, a translucent
## membrane in a dark lace frame with a central vein and ribs. One ring of `count` petals, built by `sheet` (a ribbon
## along a curved spine) and repeated around the vertical axis. Shape: `petals_inner`.
import "petal_lib"

param axis_x = 640
param base_y = 500
param height = 115
param r_base = 108
param lean = 22
param bulge = 22
param flare = 30
param spin = 0.09.turns
param s_bend = 0
param sway = 0
param wave = 8
param waves = 1
param count = 11
param half_w = 36

shape petals_inner = petal_ring(axis_x, base_y, height, r_base, lean, bulge, flare, spin, s_bend, sway, wave, waves, half_w, -0.35, count, 0.turns)
petals_inner.fill = #a995d3
petals_inner.opacity = 0.72
petals_inner.surface(roughness: 0.4, metallic: 0.35, emissive: 0.15, transmission: 1.6)
# the lace: a frame along the edges, a central vein and ribs that sweep up from the vein
petals_inner.pattern(mask: "(abs(u - 0.5) * 2 > 0.86) || (abs(u - 0.5) * 2 < 0.035) || (abs(fract(v * 11 + abs(u - 0.5) * 2 + abs(u - 0.5) * abs(u - 0.5) * 2.4) - 0.5) > 0.455 && abs(u - 0.5) * 2 < 0.86)", color: #3a2414, alpha: 0.95)

petals_inner.stroke_width = 0.35

project "Pushpak inner petals":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #f0b070

preview:
    stage3(fov: 40, exposure: 1.1, bloom: 0.2, quality: "medium", smooth: 55.deg, crease: 38.deg)
    shape sun = sun_light(dir: (-0.5, 0.5, 0.8), color: #ffd9a0, intensity: 2.2, size: 3)
    shape sky = ambient_light(color: #ffb27a, ground: #5a3a2a, intensity: 0.5)

scene "preview" for 3.seconds:
    main:
        camera3.orbit(turns: 0.1, over: 3.seconds)
