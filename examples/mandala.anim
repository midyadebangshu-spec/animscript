project "Brush modes":
    anim_version: "0.1"
    canvas: 800x600
    fps: 24
    background: #0c0a1f

import "std/2d"

let glow   = brush("rounded", radius: 13, color: #ff8a3d, opacity: 0.55)
let violet = brush("rounded", radius: 18, color: #7a3dff, opacity: 0.5)
let ink    = brush("calligraphy", radius: 3.2, color: #ffe9b8)
let shade  = brush("rounded", radius: 40, color: #1a0f4a, opacity: 0.35)
let spark  = brush("pen", radius: 2.4, color: #ffffff)

# the painting layer; a second one holds the sparks and is blended onto the scene with `add`
shape art = paint_layer(z: 5)
shape sparks = paint_layer(z: 6)
sparks.blend = "add"

scene "Mandala" for 9.seconds:
    main:
        # 1. radial symmetry: one stroke, eight copies around the centre; `screen` makes overlapping glows add up
        art.symmetry("snowflake", lines: 8)
        art.stroke(glow, [(460.0, 300.0, 0.35), (462.2, 304.4, 0.38), (464.1, 309.0, 0.41), (465.7, 313.8, 0.45), (467.0, 318.6, 0.48), (467.9, 323.4, 0.51), (468.7, 328.1, 0.54), (469.4, 332.5, 0.57), (469.9, 336.7, 0.60), (470.5, 340.5, 0.63), (471.3, 344.0, 0.65), (472.2, 346.9, 0.68), (473.4, 349.4, 0.71), (475.0, 351.2, 0.73), (477.0, 352.5, 0.76), (479.5, 353.2, 0.78), (482.3, 353.1, 0.80), (485.7, 352.2, 0.82), (489.4, 350.6, 0.84), (493.4, 348.1, 0.86), (497.7, 344.8, 0.87), (502.1, 340.5, 0.89), (506.5, 335.4, 0.90), (510.7, 329.4, 0.91), (514.7, 322.6, 0.92), (518.4, 315.1, 0.93), (521.5, 307.0, 0.94), (524.1, 298.4, 0.94), (526.0, 289.5, 0.95), (527.3, 280.5, 0.95), (528.1, 271.6, 0.95), (528.3, 262.8, 0.95), (528.0, 254.4, 0.94), (527.5, 246.5, 0.94), (526.8, 239.2, 0.93), (526.2, 232.6, 0.92), (525.6, 226.7, 0.91), (525.4, 221.8, 0.90), (525.6, 217.7, 0.89), (526.4, 214.6, 0.87), (527.9, 212.6, 0.86), (530.0, 211.5, 0.84), (532.9, 211.6, 0.82), (536.5, 212.7, 0.80), (540.8, 215.1, 0.78), (545.7, 218.8, 0.76), (551.0, 223.7, 0.73), (556.6, 229.9, 0.71), (562.3, 237.4, 0.68), (567.9, 246.2, 0.65), (573.2, 256.2, 0.63), (578.0, 267.2, 0.60), (582.2, 279.1, 0.57), (585.6, 291.7, 0.54), (588.1, 304.8, 0.51), (589.6, 318.2, 0.48), (590.3, 331.5, 0.45), (590.1, 344.6, 0.41), (589.2, 357.2, 0.38), (587.7, 369.1, 0.35)], blend: "screen") over 1.5.seconds
        art.stroke(violet, [(587.7, 369.1, 0.35), (589.2, 357.2, 0.38), (590.1, 344.6, 0.41), (590.3, 331.5, 0.45), (589.6, 318.2, 0.48), (588.1, 304.8, 0.51), (585.6, 291.7, 0.54), (582.2, 279.1, 0.57), (578.0, 267.2, 0.60), (573.2, 256.2, 0.63), (567.9, 246.2, 0.65), (562.3, 237.4, 0.68), (556.6, 229.9, 0.71), (551.0, 223.7, 0.73), (545.7, 218.8, 0.76), (540.8, 215.1, 0.78), (536.5, 212.7, 0.80), (532.9, 211.6, 0.82), (530.0, 211.5, 0.84), (527.9, 212.6, 0.86), (526.4, 214.6, 0.87), (525.6, 217.7, 0.89), (525.4, 221.8, 0.90), (525.6, 226.7, 0.91), (526.2, 232.6, 0.92), (526.8, 239.2, 0.93), (527.5, 246.5, 0.94), (528.0, 254.4, 0.94), (528.3, 262.8, 0.95), (528.1, 271.6, 0.95), (527.3, 280.5, 0.95), (526.0, 289.5, 0.95), (524.1, 298.4, 0.94), (521.5, 307.0, 0.94), (518.4, 315.1, 0.93), (514.7, 322.6, 0.92), (510.7, 329.4, 0.91), (506.5, 335.4, 0.90), (502.1, 340.5, 0.89), (497.7, 344.8, 0.87), (493.4, 348.1, 0.86), (489.4, 350.6, 0.84), (485.7, 352.2, 0.82), (482.3, 353.1, 0.80), (479.5, 353.2, 0.78), (477.0, 352.5, 0.76), (475.0, 351.2, 0.73), (473.4, 349.4, 0.71), (472.2, 346.9, 0.68), (471.3, 344.0, 0.65), (470.5, 340.5, 0.63), (469.9, 336.7, 0.60), (469.4, 332.5, 0.57), (468.7, 328.1, 0.54), (467.9, 323.4, 0.51), (467.0, 318.6, 0.48), (465.7, 313.8, 0.45), (464.1, 309.0, 0.41), (462.2, 304.4, 0.38), (460.0, 300.0, 0.35)], blend: "screen", strength: 0.8) over 1.5.seconds
        # 2. a calligraphy pen that leans the way it travels: thick and thin, eight times around
        art.symmetry("radial", lines: 8)
        art.stroke(ink, [(460.0, 300.0, 0.35), (462.2, 304.4, 0.38), (464.1, 309.0, 0.41), (465.7, 313.8, 0.45), (467.0, 318.6, 0.48), (467.9, 323.4, 0.51), (468.7, 328.1, 0.54), (469.4, 332.5, 0.57), (469.9, 336.7, 0.60), (470.5, 340.5, 0.63), (471.3, 344.0, 0.65), (472.2, 346.9, 0.68), (473.4, 349.4, 0.71), (475.0, 351.2, 0.73), (477.0, 352.5, 0.76), (479.5, 353.2, 0.78), (482.3, 353.1, 0.80), (485.7, 352.2, 0.82), (489.4, 350.6, 0.84), (493.4, 348.1, 0.86), (497.7, 344.8, 0.87), (502.1, 340.5, 0.89), (506.5, 335.4, 0.90), (510.7, 329.4, 0.91), (514.7, 322.6, 0.92), (518.4, 315.1, 0.93), (521.5, 307.0, 0.94), (524.1, 298.4, 0.94), (526.0, 289.5, 0.95), (527.3, 280.5, 0.95), (528.1, 271.6, 0.95), (528.3, 262.8, 0.95), (528.0, 254.4, 0.94), (527.5, 246.5, 0.94), (526.8, 239.2, 0.93), (526.2, 232.6, 0.92), (525.6, 226.7, 0.91), (525.4, 221.8, 0.90), (525.6, 217.7, 0.89), (526.4, 214.6, 0.87), (527.9, 212.6, 0.86), (530.0, 211.5, 0.84), (532.9, 211.6, 0.82), (536.5, 212.7, 0.80), (540.8, 215.1, 0.78), (545.7, 218.8, 0.76), (551.0, 223.7, 0.73), (556.6, 229.9, 0.71), (562.3, 237.4, 0.68), (567.9, 246.2, 0.65), (573.2, 256.2, 0.63), (578.0, 267.2, 0.60), (582.2, 279.1, 0.57), (585.6, 291.7, 0.54), (588.1, 304.8, 0.51), (589.6, 318.2, 0.48), (590.3, 331.5, 0.45), (590.1, 344.6, 0.41), (589.2, 357.2, 0.38), (587.7, 369.1, 0.35)], tilt: "follow") over 2.seconds
        # 3. a wide dark brush with `multiply` shades the centre without painting over the glow
        art.symmetry(none)
        art.stroke(shade, [(190.0, 294.0, 0.80), (198.6, 295.7, 0.80), (207.1, 297.4, 0.80), (215.7, 299.0, 0.80), (224.3, 300.5, 0.80), (232.9, 301.9, 0.80), (241.4, 303.1, 0.80), (250.0, 304.1, 0.80), (258.6, 304.9, 0.80), (267.1, 305.5, 0.80), (275.7, 305.9, 0.80), (284.3, 306.0, 0.80), (292.9, 305.9, 0.80), (301.4, 305.5, 0.80), (310.0, 304.9, 0.80), (318.6, 304.1, 0.80), (327.1, 303.1, 0.80), (335.7, 301.8, 0.80), (344.3, 300.5, 0.80), (352.9, 299.0, 0.80), (361.4, 297.4, 0.80), (370.0, 295.7, 0.80), (378.6, 294.0, 0.80), (387.1, 292.3, 0.80), (395.7, 290.6, 0.80), (404.3, 289.0, 0.80), (412.9, 287.5, 0.80), (421.4, 286.1, 0.80), (430.0, 284.9, 0.80), (438.6, 283.9, 0.80), (447.1, 283.1, 0.80), (455.7, 282.5, 0.80), (464.3, 282.1, 0.80), (472.9, 282.0, 0.80), (481.4, 282.1, 0.80), (490.0, 282.5, 0.80), (498.6, 283.1, 0.80), (507.1, 283.9, 0.80), (515.7, 284.9, 0.80), (524.3, 286.2, 0.80), (532.9, 287.5, 0.80), (541.4, 289.0, 0.80), (550.0, 290.6, 0.80), (558.6, 292.3, 0.80), (567.1, 294.0, 0.80), (575.7, 295.7, 0.80), (584.3, 297.4, 0.80), (592.9, 299.0, 0.80), (601.4, 300.5, 0.80), (610.0, 301.9, 0.80)], blend: "multiply") over 1.second
        # 4. sparks on the second layer, mirrored left and right and added to the picture
        sparks.symmetry("vertical")
        sparks.stroke(spark, [(470.0, 300.0, 0.90), (475.1, 304.0, 0.90), (480.0, 307.9, 0.90), (484.9, 311.3, 0.90), (489.8, 313.5, 0.90), (495.0, 314.0, 0.90), (500.4, 312.6, 0.90), (506.0, 309.3, 0.90), (511.5, 304.3, 0.90), (516.8, 298.3, 0.90), (521.7, 291.9, 0.90), (526.4, 286.1, 0.90), (531.1, 281.7, 0.90), (536.1, 279.4, 0.90), (541.4, 279.8, 0.90), (547.0, 282.9, 0.90), (552.8, 288.5, 0.90), (558.4, 296.1, 0.90), (563.5, 304.8, 0.90), (568.3, 313.4, 0.90), (572.8, 320.7, 0.90), (577.4, 325.6, 0.90), (582.3, 327.5, 0.90), (587.8, 325.8, 0.90), (593.7, 320.6, 0.90), (599.6, 312.4, 0.90)]) over 1.5.seconds
        wait 1.second
