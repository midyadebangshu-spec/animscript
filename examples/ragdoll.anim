project "Ragdoll and character controller":
    anim_version: "0.1"
    canvas: 800x600
    fps: 24
    background: #eef1f6

world:
    gravity: (0, 9.8)
    scale: 100

# ---- the puppet: an armature whose bones also have bodies (the `ragdoll:` line) ------------------
armature hero:
    bone torso:    at: (200, 465), length: 120, angle: -90.deg
    bone head:     parent: torso, length: 36, limits: (-40.deg, 40.deg), radius: 14
    bone arm_up_r: parent: torso, at: 0.92, length: 70, angle: 90.deg, limits: (-120.deg, 120.deg)
    bone arm_lo_r: parent: arm_up_r, length: 62, limits: (-150.deg, 0.deg)
    bone arm_up_l: parent: torso, at: 0.92, length: 70, angle: -90.deg, limits: (-120.deg, 120.deg)
    bone arm_lo_l: parent: arm_up_l, length: 62, limits: (0.deg, 150.deg)
    bone leg_r:    parent: torso, at: 0.0, length: 90, angle: 170.deg, limits: (-60.deg, 60.deg)
    bone leg_l:    parent: torso, at: 0.0, length: 90, angle: -170.deg, limits: (-60.deg, 60.deg)
    ragdoll: radius: 9, friction: 0.8

shape body = rectangle(width: 54, height: 120, at: (200, 405))
shape head_art = circle(20, radius: 30, at: (200, 327))
shape arm_r = rectangle(width: 132, height: 16, at: (266, 353))
shape arm_l = rectangle(width: 132, height: 16, at: (134, 353))
shape leg_r_art = rectangle(width: 18, height: 90, at: (204, 510))
shape leg_l_art = rectangle(width: 18, height: 90, at: (196, 510))
body.fill = #4f8fe0
head_art.fill = #f2c9a0
arm_r.fill = #e0674f
arm_l.fill = #e0674f
arm_r.stroke = none
arm_l.stroke = none
leg_r_art.fill = #35507a
leg_l_art.fill = #35507a
body.bind(hero.torso)
head_art.bind(hero.head)
leg_r_art.bind(hero.leg_r)
leg_l_art.bind(hero.leg_l)
arm_r.f1.subdivide(4)
arm_r.skin(hero, bones: [hero.arm_up_r, hero.arm_lo_r], blend: 10)
arm_l.f1.subdivide(4)
arm_l.skin(hero, bones: [hero.arm_up_l, hero.arm_lo_l], blend: 10)

# ---- the world -----------------------------------------------------------------------------------
shape ground = rectangle(width: 2000, height: 40, at: (400, 580))
ground.fill = #6b5b4b
ground.body(kind: static)
shape block = rectangle(width: 50, height: 50, at: (560, 535))
block.fill = #6b5b4b
block.body(kind: static)

# ---- a character controller: walk, stop, jump, all by steering a normal body -------------------------
shape runner = rectangle(width: 34, height: 56, at: (440, 527))
runner.fill = #e0a43a
runner.body()
runner.controller(speed: 220, accel: 1500, jump: 480)

# an action that reads the runner's current position (live reads), so it can chase a target
action run_to(self: Shape, x: Number):
    while abs(center(self).x - x) > 8:
        if center(self).x < x:
            self.move(1)
        else:
            self.move(-1)
        wait 1.frame
    self.move(0)

# jump once the runner has reached x
action jump_at(self: Shape, x: Number):
    while center(self).x < x:
        wait 1.frame
    self.jump()

scene "Ragdoll" for 10.seconds:
    main:
        # the runner heads right and hops over the block while the puppet waves
        start runner.run_to(700)
        start runner.jump_at(470)
        # the puppet is animated: bones follow keyframes and push things, nothing is simulated yet
        repeat 2 times:
            hero.arm_up_l.keyframes over 0.8.seconds:
                at 0.s: rotation = 0.deg
                at 0.4.s: rotation = -70.deg ease ease_in_out
                at 0.8.s: rotation = 0.deg ease ease_in_out
        wait 0.8.seconds
        # knocked over: the bones become dynamic, keep their motion and get a shove
        hero.ragdoll(push: (-120, -90))
        wait 3.seconds
        # a muscle: the joints are pulled back towards the animated pose, the puppet gets up
        hero.ragdoll(strength: 0.9)
        wait 3.seconds
        hero.animate()
        wait 1.second
