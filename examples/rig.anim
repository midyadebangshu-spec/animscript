project "Rig":
    anim_version: "0.1"
    canvas: 800x600
    fps: 24
    background: #eef1f6

# the skeleton: bones are nodes, never drawn. A child bone hangs off its parent (at: 1 = its tip, the
# default); angles are relative to the parent, limits are the allowed pose rotation.
armature hero:
    bone torso:   at: (400, 400), length: 120, angle: -90.deg
    bone head:    parent: torso, length: 36, limits: (-40.deg, 40.deg)
    bone arm_up_r: parent: torso, at: 0.92, length: 70, angle: 90.deg, limits: (-120.deg, 120.deg)
    bone arm_lo_r: parent: arm_up_r, length: 62, limits: (-150.deg, 0.deg)
    bone arm_up_l: parent: torso, at: 0.92, length: 70, angle: -90.deg
    bone arm_lo_l: parent: arm_up_l, length: 62, limits: (0.deg, 150.deg)
    bone leg_r:   parent: torso, at: 0.0, length: 90, angle: 170.deg
    bone leg_l:   parent: torso, at: 0.0, length: 90, angle: -170.deg
    ik reach_r: chain: [arm_up_r, arm_lo_r]

# the art: ordinary shapes. bind = the whole shape follows one bone; skin = each vertex follows several
shape body = rectangle(width: 54, height: 120, at: (400, 340))
shape head_art = circle(20, radius: 30, at: (400, 262))
shape arm_r = rectangle(width: 132, height: 16, at: (466, 288))
shape arm_l = rectangle(width: 132, height: 16, at: (334, 288))
shape leg_r_art = rectangle(width: 18, height: 90, at: (404, 445))
shape leg_l_art = rectangle(width: 18, height: 90, at: (396, 445))
body.fill = #4f8fe0
head_art.fill = #f2c9a0
arm_r.fill = #e0674f
arm_l.fill = #e0674f
arm_r.stroke = none
arm_l.stroke = none
leg_r_art.fill = #35507a
leg_l_art.fill = #35507a
body.bind(hero.torso)
head_art.bind(hero.head)
leg_r_art.bind(hero.leg_r)
leg_l_art.bind(hero.leg_l)
arm_r.f1.subdivide(4)          # a mesh, so the elbow bends smoothly
arm_r.skin(hero, bones: [hero.arm_up_r, hero.arm_lo_r], blend: 10)
arm_l.f1.subdivide(4)
arm_l.skin(hero, bones: [hero.arm_up_l, hero.arm_lo_l], blend: 10)

shape ground = rectangle(width: 780, height: 30, at: (400, 570))
ground.fill = #6b5b4b

scene "Rig" for 8.seconds:
    main:
        # forward kinematics: set bone angles like any property
        hero.head.rotate_to(25.deg) over 0.5.seconds
        # inverse kinematics: the right hand goes to points, the arm follows
        hero.reach_r.reach((505, 215)) over 1.second
        hero.reach_r.reach((520, 300)) over 1.second
        hero.reach_r.reach((480, 195)) over 1.second
        hero.reach_r.release() over 0.5.seconds
        # a clip is just keyframes on bones; repeat it
        repeat 3 times:
            hero.arm_up_l.keyframes over 0.8.seconds:
                at 0.s: rotation = 0.deg
                at 0.4.s: rotation = -60.deg ease ease_in_out
                at 0.8.s: rotation = 0.deg ease ease_in_out
        hero.head.rotate_to(0.deg) over 0.5.seconds
        hero.torso.move_by(120, 0) over 1.5.seconds ease ease_in_out
