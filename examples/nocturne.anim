project "Nocturne":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #0a0b14

# Music written as code. The `score` has a tempo, a key and four tracks: strings playing a progression written
# as roman numerals, a synth bass, a drum pattern and a bell arpeggio. `play(night)` puts it on the timeline,
# and the picture listens: `night.kick` and the other track names are levels that jump when that track plays a
# note, `night.pulse` is a beat-long flash, `night.beat_now` is true for the tick each beat begins. The orbs are
# lit by a lamp whose brightness follows the beat. Render the sound with `anim audio nocturne.anim -o nocturne.wav`
# and join it to the frames with ffmpeg (see DOCUMENT.md).
score night:
    tempo: 96, meter: "4/4", key: "A minor", reverb: 0.3, delay: 0.12, delay_time: 0.46, swing: 0.15
    track strings: instrument: "pad", chords: "i | VI | III | VII", repeat: 3, volume: 0.55, pan: -0.15
    track bass: instrument: "synth_bass", notes: ["A2:1/8 . A2:1/8 A2:1/8 . E3:1/8 . A2:1/8", "F2:1/8 . F2:1/8 F2:1/8 . C3:1/8 . F2:1/8", "C3:1/8 . C3:1/8 C3:1/8 . G3:1/8 . C3:1/8", "G2:1/8 . G2:1/8 G2:1/8 . D3:1/8 . G2:1/8"], repeat: 3, volume: 0.8, bars: 1
    track drums: instrument: "drumkit", beat: "k...h...s...h..h", steps: 16, repeat: 12, volume: 0.9, bars: 2
    track kick: instrument: "drumkit", beat: "K...............", steps: 16, repeat: 12, volume: 0.0, bars: 2
    track bells: instrument: "bell", chords: "i | VI | III | VII", style: "arp_up", rate: "1/8", octave: 5, repeat: 2, volume: 0.35, pan: 0.3, bars: 4, vel: 0.55

shape glow = circle(n: 64, radius: 300, at: (640, 360))
glow.fill = #2a1a5a
glow.stroke_width = 0
glow.opacity = 0.0
glow.z = -5

shape core = circle(n: 64, radius: 90, at: (640, 360))
core.fill = #ffd9a0
core.stroke_width = 0
core.lit(bevel: 60, roughness: 0.3, emissive: 0.6, depth: 0)

shape orb0 = circle(n: 40, radius: 34, at: (870.0, 360.0))
orb0.fill = #7aa7ff
orb0.stroke_width = 0
orb0.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb1 = circle(n: 40, radius: 34, at: (802.6, 522.6))
orb1.fill = #7aa7ff
orb1.stroke_width = 0
orb1.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb2 = circle(n: 40, radius: 34, at: (640.0, 590.0))
orb2.fill = #7aa7ff
orb2.stroke_width = 0
orb2.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb3 = circle(n: 40, radius: 34, at: (477.4, 522.6))
orb3.fill = #7aa7ff
orb3.stroke_width = 0
orb3.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb4 = circle(n: 40, radius: 34, at: (410.0, 360.0))
orb4.fill = #7aa7ff
orb4.stroke_width = 0
orb4.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb5 = circle(n: 40, radius: 34, at: (477.4, 197.4))
orb5.fill = #7aa7ff
orb5.stroke_width = 0
orb5.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb6 = circle(n: 40, radius: 34, at: (640.0, 130.0))
orb6.fill = #7aa7ff
orb6.stroke_width = 0
orb6.lit(bevel: 24, roughness: 0.4, depth: 0)
shape orb7 = circle(n: 40, radius: 34, at: (802.6, 197.4))
orb7.fill = #7aa7ff
orb7.stroke_width = 0
orb7.lit(bevel: 24, roughness: 0.4, depth: 0)

shape lamp = point_light(at: (640, 360, -260), color: #ffb878, intensity: 3.2, reach: 320)
shape cool = point_light(at: (200, 100, -300), color: #5a7aff, intensity: 1.4, reach: 500)
shape haze = ambient_light(color: #2a3060, intensity: 0.25)

stage3(bloom: 0.5, exposure: 1.1, quality: "low")

scene "Nocturne" for 14.seconds:
    main:
        play(night)
        for f in 0..(14 * 24):
            lamp.opacity = 0.35 + 0.65 * night.pulse
            cool.opacity = 0.5 + 0.5 * night.bells
            core.scale = 1 + 0.35 * night.kick + 0.06 * night.pulse
            glow.opacity = 0.15 + 0.5 * night.strings
            wait 1.frame
