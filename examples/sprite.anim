project "Sprites":
    anim_version: "0.1"
    canvas: 800x600
    fps: 24
    background: #e9eef5

world:
    gravity: (0, 9.8)
    scale: 100

shape ground = rectangle(width: 780, height: 30, at: (400, 570))
ground.fill = #6b5b4b
ground.body(kind: static)

# a flag: a textured grid, pinned along its left edge, waving as a soft body
shape flag = grid(12, width: 240, height: 160, at: (560, 150))
flag.fill = image("assets/flag.png")
flag.stroke = none
flag.soft(stiffness: 0.5, bend: 0.05)
flag.pin(flag.vertices.where(v -> v.x < 441))

# a bouncing face: a textured rigid body (a plain square, a 128 px picture on it)
shape face = circle(24, radius: 60, at: (200, 120))
face.fill = image("assets/face.png")
face.stroke = none
face.body(restitution: 0.75)

scene "Sprites" for 6.seconds:
    main:
        wait 1.second
        flag.soft_impulse((900, -200))
        wait 1.5.seconds
        flag.soft_impulse((-500, 100))
        wait 3.5.seconds
