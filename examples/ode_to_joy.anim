project "Ode to Joy":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #121528

# Ode to Joy: the theme of the last movement of Beethoven's Ninth Symphony (1824; public domain), as a small
# orchestra. The 16-bar theme is played four times in 4/4, in C major, each time with more of the orchestra:
# cello alone over the bass; violin with strings and harp; flute with piano and timpani; and the full group
# (violin and flute an octave apart, brass, bells) for the last pass, then a closing chord. Everything the picture
# does comes from the music (`ode.<track>` levels).
score ode:
    tempo: 108, meter: "4/4", key: "C major", reverb: 0.3, room: 0.7
    track cello: instrument: "cello", volume: 0.9, transpose: -12, notes: ["p E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | E4:3/8 D4:1/8 D4:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2", "D4:1/4 D4 E4 C4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 C4:1/4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 D4:1/4 | C4:1/4 D4:1/4 G3:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2"]
    track bass: instrument: "synth_bass", volume: 0.5, repeat: 4, notes: "C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 G2:1/4 D3:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | G2:1/4 D3:1/4 C2:1/4 G2:1/4 | G2:1/4 D3:1/4 G2:1/4 D3:1/4 | G2:1/4 D3:1/4 G2:1/4 D3:1/4 | G2:1/4 D3:1/4 G2:1/4 D3:1/4 | C2:1/4 G2:1/4 G2:1/4 D3:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | C2:1/4 G2:1/4 C3:1/4 G2:1/4 | G2:1/4 D3:1/4 C2:1/4 G2:1/4"
    track violin_a: instrument: "violin", volume: 0.85, bars: 16, notes: ["mp E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | E4:3/8 D4:1/8 D4:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2", "D4:1/4 D4 E4 C4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 C4:1/4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 D4:1/4 | C4:1/4 D4:1/4 G3:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2"]
    track strings: instrument: "pad", volume: 0.4, bars: 16, repeat: 3, chords: "C | C | C | C G | C | C | C | G C | G | G | G7 | C G | C | C | C | G C"
    track harp: instrument: "harp", volume: 0.5, bars: 16, repeat: 2, style: "arp_up", rate: "1/8", octave: 4, chords: "C | C | C | C G | C | C | C | G C | G | G | G7 | C G | C | C | C | G C"
    track flute_a: instrument: "flute", volume: 0.8, bars: 32, notes: ["mf E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | E4:3/8 D4:1/8 D4:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2", "D4:1/4 D4 E4 C4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 C4:1/4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 D4:1/4 | C4:1/4 D4:1/4 G3:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2"]
    track piano: instrument: "piano", volume: 0.55, bars: 32, repeat: 2, style: "arp_up", rate: "1/8", octave: 3, chords: "C | C | C | C G | C | C | C | G C | G | G | G7 | C G | C | C | C | G C"
    track timpani: instrument: "drumkit", volume: 0.8, bars: 32, repeat: 31, beat: "t.t.", steps: 4
    track violin_b: instrument: "violin", volume: 0.9, bars: 48, notes: ["f E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | E4:3/8 D4:1/8 D4:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2", "D4:1/4 D4 E4 C4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 C4:1/4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 D4:1/4 | C4:1/4 D4:1/4 G3:1/2", "ff E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2"]
    track flute_b: instrument: "flute", volume: 0.7, bars: 48, transpose: 12, notes: ["f E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | E4:3/8 D4:1/8 D4:1/2", "E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2", "D4:1/4 D4 E4 C4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 C4:1/4 | D4:1/4 E4:1/8 F4:1/8 E4:1/4 D4:1/4 | C4:1/4 D4:1/4 G3:1/2", "ff E4:1/4 E4 F4 G4 | G4:1/4 F4 E4 D4 | C4:1/4 C4 D4 E4 | D4:3/8 C4:1/8 C4:1/2"]
    track brass: instrument: "brass", volume: 0.5, bars: 48, chords: "C | C | C | C G | C | C | C | G C | G | G | G7 | C G | C | C | C | G C"
    track bells: instrument: "bell", volume: 0.25, bars: 48, style: "arp_up", rate: "1/8", octave: 5, vel: 0.45, chords: "C | C | C | C G | C | C | C | G C | G | G | G7 | C G | C | C | C | G C"
    track coda: instrument: "brass", volume: 0.65, bars: 64, hold: 1.0, octave: 3, chords: "C | C"
    track coda_strings: instrument: "pad", volume: 0.5, bars: 64, hold: 1.0, octave: 3, chords: "C | C"
    track coda_hit: instrument: "drumkit", volume: 0.9, bars: 63, beat: "t.t.|c...|", steps: 4

shape sun = circle(n: 64, radius: 150, at: (640, 250))
sun.fill = #ffd98a
sun.stroke_width = 0
sun.opacity = 0.5

shape halo = circle(n: 64, radius: 300, at: (640, 250))
halo.fill = #5a4aa0
halo.stroke_width = 0
halo.opacity = 0.1
halo.z = -2

shape floor = rectangle(width: 1400, height: 200, at: (640, 640))
floor.fill = #0a0c18
floor.stroke_width = 0
shape eq_cello = rectangle(width: 70, height: 30, at: (250, 560))
eq_cello.fill = #e08a4a
eq_cello.stroke_width = 0
shape eq_violin = rectangle(width: 70, height: 30, at: (360, 560))
eq_violin.fill = #f2c94c
eq_violin.stroke_width = 0
shape eq_flute = rectangle(width: 70, height: 30, at: (470, 560))
eq_flute.fill = #7fe0c0
eq_flute.stroke_width = 0
shape eq_harp = rectangle(width: 70, height: 30, at: (580, 560))
eq_harp.fill = #9ad0ff
eq_harp.stroke_width = 0
shape eq_piano = rectangle(width: 70, height: 30, at: (690, 560))
eq_piano.fill = #ffffff
eq_piano.stroke_width = 0
shape eq_brass = rectangle(width: 70, height: 30, at: (800, 560))
eq_brass.fill = #ff6a5a
eq_brass.stroke_width = 0
shape eq_bells = rectangle(width: 70, height: 30, at: (910, 560))
eq_bells.fill = #c9a0ff
eq_bells.stroke_width = 0
shape eq_timpani = rectangle(width: 70, height: 30, at: (1020, 560))
eq_timpani.fill = #a0a0a0
eq_timpani.stroke_width = 0

scene "Ode to Joy" for 148.seconds:
    main:
        play(ode)
        for f in 0..(148 * 24):
            sun.scale = 1 + 0.15 * (ode.violin_a + ode.violin_b + ode.flute_a + ode.brass)
            halo.opacity = 0.06 + 0.3 * (ode.strings + ode.cello)
            eq_cello.scale = (1, 1 + 8 * ode.cello)
            eq_violin.scale = (1, 1 + 8 * (ode.violin_a + ode.violin_b))
            eq_flute.scale = (1, 1 + 8 * (ode.flute_a + ode.flute_b))
            eq_harp.scale = (1, 1 + 8 * ode.harp)
            eq_piano.scale = (1, 1 + 8 * ode.piano)
            eq_brass.scale = (1, 1 + 8 * (ode.brass + ode.coda))
            eq_bells.scale = (1, 1 + 8 * ode.bells)
            eq_timpani.scale = (1, 1 + 8 * (ode.timpani + ode.coda_hit))
            wait 1.frame
