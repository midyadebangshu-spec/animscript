project "Jelly":
    anim_version: "0.1"
    canvas: 1280x720
    fps: 24
    background: #cfe6ee

import "std/3d"

# 3D soft bodies: a pressurised balloon rolls down a ramp, a solid jelly cube (filled with tetrahedra) lands on a
# pedestal, a flag hangs from a rod and flutters, a sheet drapes over a sphere, a heavy ball dents a jelly slab and a
# balloon is cut open and deflates. All of it steps together with the rigid bodies (a ball is a `.body()`, a jelly is
# a `.soft()`), and the sky is plain 2D drawn behind by `z`.
world:
    gravity: (0, 9.8, 0)
    scale: 100
    substeps: 4

stage3(fov: 40, light: (-0.7, 0.8, 0.45), ambient: 0.38, bands: 4, crease: 38.deg, smooth: 60.deg)

# ---- backdrop
shape sky_top = rectangle(width: 1500, height: 340, at: (640, 130))
sky_top.fill = #8fc7e6
sky_top.stroke_width = 0
sky_top.z = -60
shape sky_low = rectangle(width: 1500, height: 260, at: (640, 400))
sky_low.fill = #d9ecee
sky_low.stroke_width = 0
sky_low.z = -60
shape hills = polygon([(0, 420), (160, 380), (340, 410), (560, 360), (780, 405), (980, 370), (1280, 415), (1280, 560), (0, 560)])
hills.fill = #84ab72
hills.stroke_width = 0
hills.z = -50

# ---- the set (rigid)
shape ground = cube(width: 2600, height: 60, depth: 1800, at: (640, 630, 300))
ground.fill = #cdb97c
ground.stroke = #3a3020
ground.stroke_width = 3
ground.body(kind: static, friction: 0.8)

shape ramp = cube(width: 340, height: 24, depth: 200, at: (200, 520, 150))
ramp.rotation = 13.deg
ramp.fill = #9b8f7a
ramp.stroke = #3a3020
ramp.stroke_width = 3
ramp.body(kind: static, friction: 0.5)

shape pedestal = cube(width: 130, height: 110, depth: 130, at: (500, 545, 60))
pedestal.fill = #d9d3c4
pedestal.stroke = #3a3020
pedestal.stroke_width = 3
pedestal.body(kind: static)

shape post_l = cube(width: 22, height: 300, depth: 22, at: (840, 450, 185))
post_l.fill = #6b5a45
post_l.stroke = #2a2218
post_l.stroke_width = 3
post_l.body(kind: static)
shape post_r = cube(width: 22, height: 300, depth: 22, at: (1060, 450, 185))
post_r.fill = #6b5a45
post_r.stroke = #2a2218
post_r.stroke_width = 3
post_r.body(kind: static)
shape rod = cube(width: 250, height: 14, depth: 14, at: (950, 284, 185))
rod.fill = #6b5a45
rod.stroke = #2a2218
rod.stroke_width = 3
rod.body(kind: static)

shape dome = sphere(radius: 70, segments: 20, rings: 12, at: (690, 530, 330))
dome.fill = #b9b3c9
dome.stroke = #35304a
dome.stroke_width = 3
dome.body(kind: static)

shape heavy = sphere(radius: 38, segments: 20, rings: 12, at: (1100, 120, 20))
heavy.fill = #444a5c
heavy.stroke = #12141c
heavy.stroke_width = 3
heavy.body(density: 12, restitution: 0.1)

# ---- the soft bodies
shape rolling = sphere(radius: 52, segments: 18, rings: 11, at: (90, 330, 150))
rolling.fill = #d8503a
rolling.stroke = #4a1a12
rolling.stroke_width = 3
rolling.soft(pressure: 1.0, stiffness: 0.85, restitution: 0.5, friction: 0.6)

shape wobbly = cube(size: 92, subdivide: 6, at: (500, 100, 60))
wobbly.fill = #5fbf6a
wobbly.stroke = #1c4a24
wobbly.stroke_width = 3
wobbly.soft(solid: true, stiffness: 0.55, resolution: 7, restitution: 0.3, damping: 0.05)

shape flag = plane(width: 210, depth: 130, nx: 14, nz: 9, at: (950, 294, 250))
flag.fill = #e0523c
flag.stroke = #5a1c10
flag.stroke_width = 2
flag.soft(stiffness: 0.9, bend: 0.12, density: 0.3, thickness: 3)
flag.pin_where(p -> p.z < 190)

shape cloth = plane(width: 270, depth: 270, nx: 16, nz: 16, at: (690, 250, 330))
cloth.fill = #e9c46a
cloth.stroke = #5a4710
cloth.stroke_width = 2
cloth.soft(stiffness: 0.9, bend: 0.15, density: 0.3, thickness: 3)

shape slab = cube(width: 220, height: 56, depth: 170, subdivide: 8, at: (1100, 572, 20))
slab.fill = #6ac7d9
slab.stroke = #1a4a56
slab.stroke_width = 3
slab.soft(solid: true, stiffness: 0.45, resolution: 8, damping: 0.15)

shape popper = sphere(radius: 52, segments: 18, rings: 11, at: (330, 548, -80))
popper.fill = #3d7fa3
popper.stroke = #17313f
popper.stroke_width = 3
popper.soft(pressure: 1.3, stiffness: 0.85, friction: 0.9, damping: 0.4, restitution: 0.4)

# a puff of wind every so often, from a slightly different direction
action gusts(self: Shape):
    for i in 0..14:
        self.soft_impulse(by: (20 - (i % 4) * 14, -10, -30 - (i % 3) * 18))
        wait 0.6.seconds

scene "Jelly" for 10.seconds:
    main:
        start camera3.orbit(turns: 0.03, over: 10.seconds)
        start camera3.crane(height: 120, pitch: 0.03, over: 10.seconds)
        start flag.gusts()
        # at 4 s a blade slices the flag across: the lower half falls away
        wait 4.seconds
        flag.cut(from: (830, 365, 205), to: (1070, 365, 205), width: 42)
        wait 10.seconds
